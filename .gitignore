# TongYi-Lite .gitignore

# === Build outputs ===
**/build/
**/.dart_tool/
**/.gradle/
**/generated/
*.apk
*.aab
*.ap_
*.dex
*.class
*.jar
*.so
*.o
*.a
*.d
*.log

# === Flutter ===
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# === Android ===
*.iml
.idea/
*.hprof
local.properties
.android/
captures/

# === Native / llama.cpp ===
third_party/llama.cpp/build/
third_party/llama.cpp/ggml/src/ggml-cpu/ggml-cpu.c  # generated
third_party/llama.cpp/src/llama.cpp                      # generated

# === Models (large files, never commit) ===
models/*.gguf
models/*.bin

# === Debug / analysis artifacts (local only, never commit) ===
.cache/
.tmp_screen.png
*_head.bin
ui_*.xml
ui_*.txt
analyze_gguf.py
scan_nextn.py
docs/学习- 不做git提交/

# === Android build artifacts ===
android/app/.cxx/
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
android/gradle/wrapper/gradle-wrapper.jar

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === IDE ===
.vscode/
*.swp
*.swo
*~

# === Secrets ===
*.keystore
*.jks
key.properties

# === Archives ===
*.zip
*.tar.gz
*.tar.bz2
*.7z
.zcode/
logcat_output.txt

# 真机调试抓取的 logcat / 诊断日志
tyl_*.txt
diag_*.txt

# 本机工作记忆 + 调试临时文件（含本地绝对路径），不进远程
.workbuddy/

# KleidiAI 第三方源码（vendored，构建沙箱无 GitHub 需本地存在；可从官方仓库重建）
third_party/kleidiai/

# Khronos OpenCL-Headers（vendored，Android NDK 无 OpenCL SDK；可从官方仓库重建）
third_party/OpenCL-Headers/
