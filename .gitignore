# TongYi-Lite .gitignore

# === Build outputs ===
**/build/
**/.dart_tool/
**/.gradle/
**/generated/
*.apk
*.aab
# 例外：releases/ 下的版本化发布包有意入库（README 提供 GitHub 直达下载链接）。
!releases/*.apk
*.ap_
*.dex
*.class
*.jar
*.so
# 例外：jniLibs 下随 APK 分发的捆绑原生库必须入库（同 KleidiAI/OpenCL-Headers 入库理由，
# 否则其他开发机 clone 后打不出 Turnip 包）。目前仅 libturnip_freedreno.so，见其旁 README。
!android/app/src/main/jniLibs/**/*.so
*.o
*.a
*.d
*.log

# === Flutter ===
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# === Android ===
*.iml
.idea/
*.hprof
local.properties
.android/
captures/

# === Native / llama.cpp ===
third_party/llama.cpp/build/
third_party/llama.cpp/.git/                    # vendored 目录内部 git 库，绝不入库
third_party/llama.cpp.b10176/                  # 旧版回滚备份（160MB），仅本地保留，绝不入库
third_party/llama.cpp/ggml/src/ggml-cpu/ggml-cpu.c  # generated
third_party/llama.cpp/src/llama.cpp                      # generated

# === Models (large files, never commit) ===
models/*.gguf
models/*.bin

# === Debug / analysis artifacts (local only, never commit) ===
.cache/
.tmp_screen.png
*.tmpdir/
*_head.bin
*.b64
gguf_*.bin
screen.png
ui_*.xml
ui_*.txt
analyze_gguf.py
scan_nextn.py
docs/学习- 不做git提交/

# === Android build artifacts ===
android/app/.cxx/
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
android/gradle/wrapper/gradle-wrapper.jar

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === IDE ===
.vscode/
*.swp
*.swo
*~

# === Secrets ===
*.keystore
*.jks
key.properties

# === Archives ===
*.zip
*.tar.gz
*.tar.bz2
*.7z
.zcode/
logcat_output.txt

# 真机调试抓取的 logcat / 诊断日志
tyl_*.txt
diag_*.txt

# 本机工作记忆 + 调试临时文件（含本地绝对路径），不进远程
.workbuddy/

# KleidiAI / Khronos OpenCL-Headers 已直接入库（third_party/），不再忽略——
# 保证其他开发机 clone 后即可编译（构建沙箱无 GitHub 无法走 FetchContent/子模块拉取）。
# 若日后需更新，从官方仓库重新 vendor 后提交即可：ARM-software/kleidiai v1.24.0、
# KhronosGroup/OpenCL-Headers（Android NDK 无 OpenCL SDK，需本地 headers）。
third_party/llama.cpp.b10176/

# 本次构建产物 + 临时 Gradle home（不进入仓库）
_build_log/
android/.gradle-home/

# 本机调试产物 + 真机验证日志（含宿主复现二进制/模型缓存），不进仓库
.upgrade-tmp/
gate4_logcat.ps1

# === 本地实验/研究目录与临时产物（不入库）===
_study/
_probe/
.research/
assets/flutter_assets/
out.txt
app_log.txt
.phase6_out.txt
.test_out.txt

# === 调试/临时 APK 不入库（仅正式 releases/*）===
*.idsig
releases/*debug*.apk
releases/*vkdiag*.apk
releases/*bonsai2*.apk
releases/*agent-stall-fix*.apk
skill.dart.bak
ui.xml

# 本地验证工作区（2026-09-28）：spike worktree 与 OpenCL/Vulkan 桌面构建链
wt/
_build/

# 无线 ADB 缓存（手机 IP，因人/因网而异，不入库）
scripts/.adb_wifi_*

.tmp-mdtool/
README.html
TongYi-Lite-ProductSpec.html
spec-images/
