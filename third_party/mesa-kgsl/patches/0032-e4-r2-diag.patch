+/* [TongYi-Lite 0032 E4 round-2] In-flight IB mutation detector (R10 verdict).
+ * At ioctl submit time we CRC each IB region and remember (handle -> ptr/size/
+ * crc/ts/queue). Two observation points consume the table (TYL_E4 gated):
+ *   E4REUSE  - freedreno_bo.c ring-cache acquire: is the batch that last used
+ *              this ring retired (non-blocking WAITTIMESTAMP timeout=0)?  A
+ *              ring acquired while its batch has NOT retired = CPU about to
+ *              record into memory the GPU may still be reading (R10).
+ *   E4VERIFY - kgsl_pipe.c wait success: bytes must still equal submit time;
+ *              MISMATCH = somebody wrote them without an intervening acquire.
+ */
+#include <time.h>
+
+#define E4_TABLE_SZ 512u
+
+struct e4_save {
+    uint32_t handle;
+    uint32_t ts;         /* 0 = pending ts fill (deferred submits) */
+    uint32_t saved_gen;  /* e4_flushes value used for pending fill */
+    uint64_t gpuaddr;
+    uint32_t size;
+    uint32_t crc;
+    const uint32_t *map;
+    uint32_t queue_id;
+    int valid;
+};
+
+static struct e4_save e4_table[E4_TABLE_SZ];
+
+static unsigned long long
+e4_now_ns(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_REALTIME, &t);
+    return (unsigned long long)t.tv_sec * 1000000000ull +
+           (unsigned long long)t.tv_nsec;
+}
+
+static uint32_t
+e4_crc32(const void *data, size_t len)
+{
+    const uint8_t *p = data;
+    uint32_t crc = 0xFFFFFFFFu;
+    for (size_t i = 0; i < len; i++) {
+        crc ^= p[i];
+        for (int b = 0; b < 8; b++)
+            crc = (crc >> 1) ^ (0xEDB88320u & -(int32_t)(crc & 1));
+    }
+    return ~crc;
+}
+
+static void
+e4_save_cmd(struct fd_bo *bo, uint64_t gpuaddr, uint32_t size, uint32_t ts,
+            uint32_t queue_id)
+{
+    if (!bo || !bo->map || size == 0 || size > (1u << 20))
+        return;
+    uint64_t off = gpuaddr - bo->iova;
+    if (off + size > bo->size)
+        return;
+    const uint32_t *ptr = (const uint32_t *)((const uint8_t *)bo->map + off);
+    uint32_t crc = e4_crc32(ptr, size);
+    unsigned i0 = bo->handle & (E4_TABLE_SZ - 1);
+    for (unsigned n = 0; n < 8; n++) {
+        struct e4_save *e = &e4_table[(i0 + n) & (E4_TABLE_SZ - 1)];
+        if (!e->valid || e->handle == bo->handle) {
+            e->handle = bo->handle;
+            e->ts = ts;
+            e->saved_gen = ts ? 0 : e4_flushes + 1;
+            e->gpuaddr = gpuaddr;
+            e->size = size;
+            e->crc = crc;
+            e->map = ptr;
+            e->queue_id = queue_id;
+            e->valid = 1;
+            return;
+        }
+    }
+    struct e4_save *e = &e4_table[i0];
+    e->handle = bo->handle;
+    e->ts = ts;
+    e->saved_gen = ts ? 0 : e4_flushes + 1;
+    e->gpuaddr = gpuaddr;
+    e->size = size;
+    e->crc = crc;
+    e->map = ptr;
+    e->queue_id = queue_id;
+    e->valid = 1;
+}
+
+void kgsl_e4_verify(struct fd_device *dev, uint32_t queue_id, uint32_t ts);
+void kgsl_e4_ring_reused(struct fd_bo *bo);
+
+void
+kgsl_e4_verify(struct fd_device *dev, uint32_t queue_id, uint32_t ts)
+{
+    (void)dev;
+    if (!e4_enabled() || ts == 0)
+        return;
+    for (unsigned i = 0; i < E4_TABLE_SZ; i++) {
+        struct e4_save *e = &e4_table[i];
+        if (!e->valid || e->ts != ts || e->queue_id != queue_id)
+            continue;
+        if (!e->map)
+            continue;
+        uint32_t now = e4_crc32(e->map, e->size);
+        fprintf(stderr,
+            "E4VERIFY ts=%u handle=%u gpuaddr=0x%llx size=%u crc_then=%08x crc_now=%08x %s rt=%llu\n",
+            ts, e->handle, (unsigned long long)e->gpuaddr, e->size,
+            e->crc, now, (now == e->crc) ? "OK" : "MISMATCH", e4_now_ns());
+    }
+}
+
+void __attribute__((weak))
+kgsl_e4_ring_reused(struct fd_bo *bo)
+{
+    if (!e4_enabled() || !bo)
+        return;
+    unsigned i0 = bo->handle & (E4_TABLE_SZ - 1);
+    int seen = 0;
+    for (unsigned n = 0; n < 8; n++) {
+        struct e4_save *e = &e4_table[(i0 + n) & (E4_TABLE_SZ - 1)];
+        if (!e->valid || e->handle != bo->handle)
+            continue;
+        seen = 1;
+        int reached = -1;
+        if (e->ts != 0) {
+            struct kgsl_device_waittimestamp_ctxtid wait = {
+                .context_id = e->queue_id,
+                .timestamp = e->ts,
+                .timeout = 0,
+            };
+            reached = (kgsl_pipe_safe_ioctl(bo->dev->fd,
+                IOCTL_KGSL_DEVICE_WAITTIMESTAMP_CTXTID, &wait) == 0) ? 1 : 0;
+        }
+        uint32_t now = e->map ? e4_crc32(e->map, e->size) : 0;
+        fprintf(stderr,
+            "E4REUSE handle=%u ts=%u reached=%d crc_then=%08x crc_now=%08x %s rt=%llu\n",
+            bo->handle, e->ts, reached, e->crc, now,
+            (!e->map) ? "NOMAP" : ((now == e->crc) ? "OK" : "MISMATCH"),
+            e4_now_ns());
+    }
+    if (!seen)
+        fprintf(stderr, "E4REUSE handle=%u fresh rt=%llu\n", bo->handle, e4_now_ns());
+}
