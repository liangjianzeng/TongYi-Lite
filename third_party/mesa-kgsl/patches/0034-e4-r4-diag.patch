+/* [TongYi-Lite 0034 E4] non-blocking retire check used by E4FAST (rk=) and
+ * E4BOREUSE (reached=): 1 = KMD says ts retired, 0 = still in flight,
+ * -1 = no ts, -2 = helper missing (weak). */
+static struct fd_pipe *kgsl_e4_async_pipe;
+
+void kgsl_e4_set_async_pipe(struct fd_pipe *pipe);
+void
+kgsl_e4_set_async_pipe(struct fd_pipe *pipe)
+{
+   kgsl_e4_async_pipe = pipe;
+}
+
+int kgsl_e4_pipe_ts_reached(struct fd_pipe *pipe, uint32_t ts);
+int
+kgsl_e4_pipe_ts_reached(struct fd_pipe *pipe, uint32_t ts)
+{
+   struct kgsl_pipe *kgsl_pipe;
+   struct kgsl_device_waittimestamp_ctxtid wait = { 0 };
+   int fd;
+
+   if (!pipe && kgsl_e4_async_pipe)
+      pipe = kgsl_e4_async_pipe;
+   if (!pipe || ts == 0)
+      return -1;
+   kgsl_pipe = to_kgsl_pipe(pipe);
+   fd = pipe->dev->fd;
+   wait.context_id = kgsl_pipe->queue_id;
+   wait.timestamp = ts;
+   wait.timeout = 0;
+   return (kgsl_pipe_safe_ioctl(fd, IOCTL_KGSL_DEVICE_WAITTIMESTAMP_CTXTID,
+                                &wait) == 0) ? 1 : 0;
+}
