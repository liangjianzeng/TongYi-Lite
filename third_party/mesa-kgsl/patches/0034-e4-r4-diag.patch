+#include <stdlib.h>
+#include <stdio.h>
+
+/* === [TongYi-Lite 0034 E4 round-4] BO_CACHE in-flight reuse probe (R11). ===
+ * Release side tags {handle -> last submit ts/qid}; acquire side asks the KMD
+ * (non-blocking WAITTIMESTAMP timeout=0) whether that batch has retired.
+ * reached=0 on reacquire = handed out while some batch was still in flight.
+ * NOTE the ts attribution is approximate (last submit at release time, not
+ * necessarily a batch that touched this bo) — adjudicate by async-vs-control
+ * RATE comparison plus E4FAST rk= data, not by any single line. */
+struct e4_rel {
+   uint32_t handle;
+   uint32_t ts;
+   uint32_t qid;
+   int valid;
+};
+#define E4_REL_SZ 1024
+static struct e4_rel e4_rel_table[E4_REL_SZ];
+
+static uint32_t e4_last_ts, e4_last_qid;
+
+static int
+e4rel_on(void)
+{
+   static int on = -1;
+   if (on < 0)
+      on = (getenv("TYL_E4") && getenv("TYL_E4")[0] == '1') ? 1 : 0;
+   return on;
+}
+
+void kgsl_e4_note_submit(uint32_t ts, uint32_t qid);
+void
+kgsl_e4_note_submit(uint32_t ts, uint32_t qid)
+{
+   if (!e4rel_on())
+      return;
+   e4_last_ts = ts;
+   e4_last_qid = qid;
+}
+
+void kgsl_e4_bo_released(struct fd_bo *bo);
+void
+kgsl_e4_bo_released(struct fd_bo *bo)
+{
+   if (!e4rel_on() || !bo)
+      return;
+   unsigned i0 = bo->handle & (E4_REL_SZ - 1);
+   for (unsigned n = 0; n < 8; n++) {
+      struct e4_rel *e = &e4_rel_table[(i0 + n) & (E4_REL_SZ - 1)];
+      if (!e->valid || e->handle == bo->handle) {
+         e->handle = bo->handle;
+         e->ts = e4_last_ts;
+         e->qid = e4_last_qid;
+         e->valid = 1;
+         fprintf(stderr, "E4BOREL handle=%u ts=%u qid=%u\n",
+                 bo->handle, e->ts, e->qid);
+         return;
+      }
+   }
+}
+
+void kgsl_e4_bo_reacquired(struct fd_bo *bo);
+void
+kgsl_e4_bo_reacquired(struct fd_bo *bo)
+{
+   if (!e4rel_on() || !bo)
+      return;
+   extern int __attribute__((weak)) kgsl_e4_pipe_ts_reached(struct fd_pipe *pipe, uint32_t ts);
+   unsigned i0 = bo->handle & (E4_REL_SZ - 1);
+   for (unsigned n = 0; n < 8; n++) {
+      struct e4_rel *e = &e4_rel_table[(i0 + n) & (E4_REL_SZ - 1)];
+      if (!e->valid || e->handle != bo->handle)
+         continue;
+      int reached = -2;
+      if (e->ts != 0 && kgsl_e4_pipe_ts_reached)
+         reached = kgsl_e4_pipe_ts_reached(NULL, e->ts);  /* NULL -> async pipe */
+      fprintf(stderr, "E4BOREUSE handle=%u ts=%u qid=%u reached=%d\n",
+              bo->handle, e->ts, e->qid, reached);
+      e->valid = 0;   /* one-shot: re-acquired, observation consumed */
+      return;
+   }
+}
