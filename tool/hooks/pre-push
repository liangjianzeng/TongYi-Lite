#!/usr/bin/env bash
# pre-push 闸门：① 拦住私有工程记忆再次流进公开仓；② 质量门禁（analyze+test 绿才许推）。
#
# 背景：AGENTS.md / BUILD.md / android/AGENTS.md / 两篇 thinking 笔记 / .workbuddy 曾在
# 2026-10-28 迁往私有仓 TongYi-Lite-docs；历史已 filter-repo 重写。本钩子防的是「手滑又提交回去」
# 以及「旧历史的分支/tag 被误推」——后者一次就能让私有正文整批复活。
#
# 质量门禁（2026-11-09 健康度评审 P1-3）：真推送时跑 flutter analyze + 全量 flutter test，
# 红则拦。逃生口（评审/临场场景）：TONGYI_SKIP_QUALITY=1 git push；flutter 找不到也只警告
# 不拦（FLUTTER= 可显式指定路径）。隐私闸门不受此开关影响，永远执行。
#
# 装法（本机，一条命令）：
#   git config core.hooksPath tool/hooks
# 想全组生效就把本文件随仓提交。
#
# 手工审计：bash tool/hooks/pre-push --all（只跑隐私审计，不跑质量门禁）
set -uo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1

# 私有路径（公开仓一律不许出现，stub 例外见 ALLOW_STUB）
BANNED_PATHS=(
  "AGENTS.md"
  "BUILD.md"
  "android/AGENTS.md"
  "thinking_runaway_notes.md"
  "thinking_effort_token_meter_notes.md"
  ".workbuddy"
)
# 允许保留的指引 stub（路径:最大字节数）
declare -A ALLOW_STUB=( ["AGENTS.md"]=2000 )

# 叙述性文本与脚本里都不许出现的内网地址（2026-11-09 裁决升级：.sh/.py 的 DEV 默认值
# 同样打码改传参，不再豁免——"功能值"不是携带内网地址的通行证）。
BANNED_IP_RE='100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+|192\.168\.[0-9]+\.[0-9]+'
# 已知设备序列号（真机清单属私有工程记忆；新序列号在此追加）。
# 拆段拼接：钩子自身 blob 不含完整序列号字面量，避免自我匹配拦死自己；对外匹配不受影响。
_SN740="98f"; _SN740b="c9410"; _SN830="4332"; _SN830b="8e37"; _SNK40="8b1"; _SNK40b="e8747"
_SPW1="Lxt2"; _SPW2="01223"
BANNED_SERIAL_RE="${_SN740}${_SN740b}|${_SN830}${_SN830b}|${_SNK40}${_SNK40b}|${_SPW1}${_SPW2}"
# 扫描面 = 一切文本（含脚本与配置）；中文文件名必须 core.quotePath=false，
# 否则 rev-list 输出被引号包裹、尾引号把 '\.md$' 锚定打穿——npu-line 放行事故根因。
TEXT_EXT_RE='\.(md|markdown|html|htm|txt|text|json|jsonl|jsonc|yaml|yml|toml|ini|cfg|conf|csv|tsv|log|sh|bash|zsh|py|ps1|psm1|bat|cmd|sql|xml|env|list)$'

fail=0
note() { printf '  ✗ %s\n' "$1"; fail=1; }
qfail=0
qnote() { printf '  ✗ %s\n' "$1"; qfail=1; }

# check_rev <tip 提交> <展示标签> [扫描范围]
#   第三参缺省 = 整条历史（--all 审计 / 推全新 ref 时用）。
#   pre-push 增量推送必须传 "remote_sha..local_sha"：否则 git rev-list --objects
#   会把整条历史拉进来，历史里早已公开的旧文件让闸门永远拦死每次正常推送（2026-11-08 实锤）。
check_rev() {
  local rev="$1" label="$2" range="${3:-$1}" p obj path
  for p in "${BANNED_PATHS[@]}"; do
    if git cat-file -e "$rev:$p" 2>/dev/null; then
      local sz; sz=$(git cat-file -s "$rev:$p" 2>/dev/null || echo 0)
      local cap=${ALLOW_STUB[$p]:-0}
      if [ "$cap" -gt 0 ] && [ "$sz" -le "$cap" ]; then
        : # 指引 stub，放行
      else
        note "$label 的 $p 是 $sz B（> ${cap}B 视为私有正文，应只存在于私有仓 docs/）"
      fi
    fi
    # 扫描范围内被新增过的私有路径（增量推送 = 只看本次要推的提交）
    if [ -n "$(git log --format=%h -1 "$range" -- "$p" 2>/dev/null)" ] && [ -z "${ALLOW_STUB[$p]:-}" ]; then
      note "$label 的历史里新增过 $p"
    fi
  done
  # 叙述文本/脚本里的内网 IP 与设备序列号
  # core.quotePath=false：中文路径不被 git 加引号转义，否则 TEXT_EXT_RE 的 $ 锚定失效
  while read -r obj path; do
    [ -z "$obj" ] && continue
    case "$path" in third_party/*) continue;; esac
    printf '%s\n' "$path" | grep -qE "$TEXT_EXT_RE" || continue
    if git cat-file -p "$obj" 2>/dev/null | grep -aqE "$BANNED_IP_RE"; then
      note "$label 的 $path 含内网 IP（应打码为 <redacted-tailscale>）"
    fi
    if git cat-file -p "$obj" 2>/dev/null | grep -aqE "$BANNED_SERIAL_RE"; then
      note "$label 的 $path 含设备序列号/凭证（应打码为 <redacted-serial>/<redacted-ssh-passwd>）"
    fi
  done < <(git -c core.quotePath=false rev-list --objects "$range" 2>/dev/null | awk '{o=$1; $1=""; sub(/^ /,""); print o" "$0}' | head -40000)
}

if [ "${1:-}" = "--all" ]; then
  echo "全量审计所有本地 ref……"
  while read -r sha ref; do
    git cat-file -e "$sha^{commit}" 2>/dev/null || continue
    check_rev "$sha" "$ref"
  done < <(git for-each-ref --format='%(objectname) %(refname)')
  [ "$fail" -eq 0 ] && echo "✓ 全部 ref 干净" || echo "↑ 上面这些 ref 一旦推到公开仓就会复活私有内容"
  exit "$fail"
fi

# pre-push 模式：stdin 每行 "<local_ref> <local_sha> <remote_ref> <remote_sha>"
got=0
while read -r l_ref l_sha r_ref r_sha; do
  got=1
  case "$r_ref" in
    refs/heads/main|refs/heads/*) : ;;
  esac
  if [ "$r_sha" = "$(printf '0%.0s' {1..40})" ]; then
    continue   # 删除 ref，无需扫
  fi
  if [ "$l_sha" = "$(printf '0%.0s' {1..40})" ]; then
    continue
  fi
  # 只扫将要推出去的提交范围
  if git cat-file -e "$r_sha^{commit}" 2>/dev/null; then
    range="$r_sha..$l_sha"
  else
    range="$l_sha"
  fi
  echo "推送闸门检查 $l_ref → $r_ref ($range)"
  # 一次范围扫描，不逐提交循环：git rev-list --objects 对每个提交都会重扫整段
  # 范围（N 次 × O(范围)），实测 2 个提交就 >60 s；范围扫描本身已覆盖「中途新增
  # 后又删除」的对象，语义更准。逐提交清单单独打一行供定位。
  for c in $(git rev-list "$range" 2>/dev/null | head -2000); do
    echo "    · $(git log -1 --format='%h %s' "$c" | cut -c1-100)"
  done
  check_rev "$l_sha" "$r_ref@$(git rev-parse --short "$l_sha")" "$range"
done

if [ "$got" -eq 0 ]; then
  echo "（无 ref 推送）"; exit 0
fi

# ---- 质量门禁（②）：隐私已过才值得花这 ~30s；红则独立计数单独报文案 ----
if [ "$fail" -eq 0 ]; then
  if [ "${TONGYI_SKIP_QUALITY:-0}" = "1" ]; then
    echo "（质量门禁跳过：TONGYI_SKIP_QUALITY=1——自担风险，CI/本地须另验）"
  else
    FLUTTER_BIN="${FLUTTER:-}"
    if [ -z "$FLUTTER_BIN" ]; then
      FLUTTER_BIN=$(command -v flutter 2>/dev/null || true)
    fi
    # -f 不用 -x：Windows .bat 常无 +x 位（实测 644），但 Git Bash 照样能执行。
    if [ -z "$FLUTTER_BIN" ] && [ -f "/c/src/flutter/bin/flutter.bat" ]; then
      FLUTTER_BIN=/c/src/flutter/bin/flutter.bat   # 本机常用位置（Git Bash）
    fi
    if [ -z "$FLUTTER_BIN" ]; then
      echo "⚠ 未找到 flutter，质量门禁跳过（FLUTTER=<路径> 可显式指定）"
    else
      echo "质量门禁：flutter analyze ……"
      # 取 $() 的直接退出码，不走管道（管道尾会吞掉真实 rc——本仓踩过的坑）。
      out=$("$FLUTTER_BIN" analyze 2>&1); rc=$?
      if [ $rc -ne 0 ]; then
        printf '%s\n' "$out" | tail -25
        qnote "flutter analyze 非 0（见上）"
      fi
      if [ "$qfail" -eq 0 ]; then
        echo "质量门禁：flutter test（全量，约 30s）……"
        out=$("$FLUTTER_BIN" test 2>&1); rc=$?
        if [ $rc -ne 0 ]; then
          printf '%s\n' "$out" | tail -40
          qnote "flutter test 未全绿（见上）"
        fi
      fi
    fi
  fi
fi

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'MSG'

推送被拦：上面列出的内容属私有工程记忆，公开仓不许携带。
  · 正文该进私有仓：TongYi-Lite-docs（检出在 docs/ 子模块）
  · 指引 stub 控制在 2 KB 以内
  · 一切文本（含 .sh/.py 脚本）内网 IP 打码为 <redacted-tailscale>、序列号打码为
    <redacted-serial>；脚本功能值改为环境变量/参数传入，真值存私有区不进仓
确认无误要强行推：git push --no-verify
MSG
  exit 1
fi

if [ "$qfail" -ne 0 ]; then
  cat >&2 <<'MSG'

推送被拦：质量门禁未过（flutter analyze / flutter test 红，见上）。
  · 修复后重推；确属偶发（flake）可 TONGYI_SKIP_QUALITY=1 git push 自担风险
  · 别用 --no-verify 绕质量——那会把隐私闸门一起跳过
MSG
  exit 1
fi
echo "✓ 推送闸门通过（隐私 + 质量）"
